# =============================================================
# ברנדלי - הגדרות שרת Apache (cPanel / Plesk / רוב האחסון בישראל)
# אם האתר מתארח ב-Netlify / Vercel / Cloudflare Pages - הקובץ הזה
# אינו בשימוש; ראו README.md להגדרות המקבילות.
# =============================================================

AddDefaultCharset UTF-8
Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash On
ServerSignature Off

# ------------------------- עמוד שגיאה -------------------------
ErrorDocument 404 /404.html

# ------------------- הפניות: HTTPS, www, כתובות נקיות -------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # הסרת www (בחרו גרסה אחת בלבד - זו או ההפוכה)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # ---- כתובות נקיות ----
  # האתר בנוי כתיקיות (about/index.html) ולכן /about/ עובד ללא rewrite.
  # הכללים הבאים רק מנקים כתובות ישנות או "מלוכלכות", כדי שלא ייווצר תוכן כפול.

  # /index.html  ->  /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # /about/index.html  ->  /about/
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)/index\.html[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L]

  # /about.html  ->  /about/   (תאימות לאחור לכתובות שכבר נסרקו)
  RewriteCond %{THE_REQUEST} \s/+([^/?\s]+)\.html[\s?] [NC]
  RewriteCond %1 !^404$
  RewriteRule ^ /%1/ [R=301,L]
</IfModule>

# ------------------------ סוגי קבצים ------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json  .webmanifest
  AddType image/svg+xml              .svg
  AddType image/webp                 .webp
  AddType application/xml            .xml
  # קריטי: בלי זה הדפדפן עלול לדחות את הגופן המקומי
  AddType font/woff2                 .woff2
  AddType font/woff                  .woff
  AddType image/x-icon               .ico
  AddCharset UTF-8                   .html .css .js .json .xml .txt .webmanifest
</IfModule>

# ------------------------- דחיסה -------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ------------------------- קאשינג -------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 month"
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType application/xml         "access plus 1 hour"
  ExpiresByType text/plain              "access plus 1 day"
</IfModule>

# ------------------------ כותרות אבטחה ------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Content Security Policy - האתר אינו טוען דבר מדומיין חיצוני.
  # ה-hash מתייחס לסקריפט ה-inline היחיד בעמוד (הוספת המחלקה js ל-html).
  # אם משנים את הסקריפט הזה, יש לחשב hash חדש, אחרת הדפדפן יחסום אותו.
  # אם מוסיפים Google Analytics / פיקסלים - יש להרחיב את script-src ו-connect-src.
  Header always set Content-Security-Policy "default-src 'self'; \
    script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo='; \
    style-src 'self' 'unsafe-inline'; \
    font-src 'self'; \
    img-src 'self' data:; \
    connect-src 'self'; \
    form-action 'self'; \
    frame-ancestors 'self'; \
    base-uri 'self'; \
    object-src 'none'"

  # קבצים סטטיים עם קאש ארוך - סימון immutable
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # הפאביקון בשורש מתחלף לעיתים רחוקות אך לא אמור להיתקע לשנה
  <FilesMatch "^favicon\.ico$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------ הגנה על קבצים ------------------------
<FilesMatch "^\.(htaccess|htpasswd|env|git)">
  Require all denied
</FilesMatch>
